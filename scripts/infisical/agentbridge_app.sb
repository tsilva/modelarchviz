(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "NODE_BIN")))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny network*)
(allow network-outbound (remote tcp "localhost:8283"))
(allow network-bind (local ip "localhost:*"))
(allow network-inbound (local tcp "localhost:*"))
(deny file-read-data file-write* (subpath (param "USER_HOME")))
(allow file-read-data
  (literal (param "CA_FILE"))
  (subpath (param "NODE_ROOT"))
  (literal (param "REPO_ROOT"))
  (literal (string-append (param "REPO_ROOT") "/package.json"))
  (literal (string-append (param "REPO_ROOT") "/pnpm-lock.yaml"))
  (literal (string-append (param "REPO_ROOT") "/.gitignore"))
  (literal (string-append (param "REPO_ROOT") "/tsconfig.json"))
  (literal (string-append (param "REPO_ROOT") "/next-env.d.ts"))
  (literal (string-append (param "REPO_ROOT") "/next.config.mjs"))
  (literal (string-append (param "REPO_ROOT") "/instrumentation.ts"))
  (literal (string-append (param "REPO_ROOT") "/instrumentation-client.ts"))
  (literal (string-append (param "REPO_ROOT") "/sentry.server.config.ts"))
  (literal (string-append (param "REPO_ROOT") "/requirements-notebooks-jax.txt"))
  (literal (string-append (param "REPO_ROOT") "/constraints.txt"))
  (subpath (string-append (param "REPO_ROOT") "/app"))
  (subpath (string-append (param "REPO_ROOT") "/public"))
  (subpath (string-append (param "REPO_ROOT") "/node_modules"))
  (subpath (string-append (param "REPO_ROOT") "/.next"))
  (literal (string-append (param "REPO_ROOT") "/scripts/package.json"))
  (literal (string-append (param "REPO_ROOT") "/scripts/generate-model-artifacts.mjs"))
  (literal (string-append (param "REPO_ROOT") "/scripts/model-highlight-anchors.mjs"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/package.json"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/agentbridge_client.mjs"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/agentbridge_transport.mjs"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/agentbridge_preload.mjs"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/agentbridge_app.mjs")))
(allow file-write*
  (literal (string-append (param "REPO_ROOT") "/next-env.d.ts"))
  (subpath (string-append (param "REPO_ROOT") "/.next"))
  (subpath (string-append (param "REPO_ROOT") "/app/generated"))
  (subpath (string-append (param "REPO_ROOT") "/public/notebooks"))
  (literal (string-append (param "REPO_ROOT") "/public/pdf.worker.min.mjs")))
