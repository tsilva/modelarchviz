(version 1)
(allow default)
(deny process-exec)
(allow process-exec (literal (param "NODE_BIN")))
(deny mach-lookup (global-name "com.apple.securityd") (global-name "com.apple.securityd.xpc"))
(deny network*)
(allow network-outbound (remote tcp "localhost:8283"))
(deny file-read-data file-write* (subpath (param "USER_HOME")))
(allow file-read-data
  (literal (param "CA_FILE"))
  (subpath (param "NODE_ROOT"))
  (literal (param "APP_CONFIG"))
  (literal (string-append (param "REPO_ROOT") "/package.json"))
  (literal (string-append (param "REPO_ROOT") "/src/package.json"))
  (literal (string-append (param "REPO_ROOT") "/src/lib/package.json"))
  (literal (string-append (param "REPO_ROOT") "/app/package.json"))
  (literal (string-append (param "REPO_ROOT") "/lib/package.json"))
  (literal (string-append (param "REPO_ROOT") "/lib/generation/package.json"))
  (literal (string-append (param "REPO_ROOT") "/scripts/package.json"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/package.json"))
  (literal (string-append (param "REPO_ROOT") "/scripts/infisical/agentbridge_client.mjs")))
