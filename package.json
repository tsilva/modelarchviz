{
  "name": "modelarchviz",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "generate:model-artifacts": "node scripts/generate-model-artifacts.mjs",
    "test:anchors": "node --test scripts/model-highlight-anchors.test.mjs",
    "test:dependencies": "node --test scripts/dependency-security.test.mjs",
    "test:highlights": "pnpm generate:model-artifacts && node --test scripts/model-highlight-anchors.test.mjs scripts/model-highlight-catalog.test.mjs",
    "test:routes": "node --test scripts/model-page.test.mjs scripts/chat-backend.test.mjs",
    "test:notebooks": "node --test scripts/model-notebooks.test.mjs",
    "test": "pnpm test:dependencies && pnpm test:highlights && pnpm test:routes && pnpm test:notebooks",
    "dev": "python3 scripts/infisical/run.py dev",
    "build": "pnpm generate:model-artifacts && next build",
    "start": "next start",
    "typecheck": "pnpm generate:model-artifacts && tsc --noEmit",
    "dev:app": "pnpm generate:model-artifacts && node scripts/dev-server.mjs",
    "dev:secrets": "python3 scripts/infisical/run.py dev",
    "build:secrets": "python3 scripts/infisical/run.py build",
    "start:secrets": "python3 scripts/infisical/run.py start",
    "secrets:check": "python3 scripts/infisical/run.py check",
    "test:secrets": "python3 -m unittest discover -s scripts/infisical -p test_secrets.py"
  },
  "dependencies": {
    "@sentry/nextjs": "^11.4.0",
    "@vercel/analytics": "2.0.1",
    "next": "16.4.0",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/node": "26.6.4",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "typescript": "5.6.3"
  },
  "packageManager": "pnpm@10.33.0"
}
