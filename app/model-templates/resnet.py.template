# %%
import torch
import torch.nn as nn


# %%
# @arch class-basicblock-nn-module:start
class BasicBlock(nn.Module):
# @arch class-basicblock-nn-module:end
    expansion = 1

    def __init__(
        self,
        in_channels,  # Number of input channels.
        out_channels,  # Number of output channels before expansion.
        stride=1,  # Spatial stride for the first convolution.
        downsample=None  # Optional projection for the residual path.
    ):
        super().__init__()

        # Register the two-convolution residual branch and optional projection shortcut.
        # @arch basicblock.self-convn-nn-convnd:start
        self.conv1 = nn.Conv2d(
        # @arch basicblock.self-convn-nn-convnd:end
            in_channels,
            out_channels,
            kernel_size=3,
            stride=stride,
            padding=1,
            bias=False,
        )
        # @arch basicblock.self-bnn-nn-batchnormnd-out_channels:start
        self.bn1 = nn.BatchNorm2d(out_channels)
        # @arch basicblock.self-bnn-nn-batchnormnd-out_channels:end
        # @arch basicblock.self-relu-nn-relu-inplace-true:start
        self.relu = nn.ReLU(inplace=True)
        # @arch basicblock.self-relu-nn-relu-inplace-true:end
        # @arch basicblock.self-convn-nn-convnd-out_channels-out_channels-kernel_size-n-padding-n-b:start
        self.conv2 = nn.Conv2d(out_channels, out_channels, kernel_size=3, padding=1, bias=False)
        # @arch basicblock.self-convn-nn-convnd-out_channels-out_channels-kernel_size-n-padding-n-b:end
        # @arch basicblock.self-bnn-nn-batchnormnd-out_channels.2:start
        self.bn2 = nn.BatchNorm2d(out_channels)
        # @arch basicblock.self-bnn-nn-batchnormnd-out_channels.2:end
        self.downsample = downsample

    def forward(self, x):
        # Preserve the residual path, projecting it when shape changes.
        identity = x  # (batch, in_channels, height, width)

        # Apply the residual branch.
        # @arch basicblock.forward.out-self-convn-x:start
        out = self.conv1(x)  # (batch, in_channels, height, width) -> (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-convn-x:end
        # @arch basicblock.forward.out-self-bnn-out:start
        out = self.bn1(out)  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-bnn-out:end
        # @arch basicblock.forward.out-self-relu-out:start
        out = self.relu(out)  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-relu-out:end
        # @arch basicblock.forward.out-self-convn-out:start
        out = self.conv2(out)  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-convn-out:end
        # @arch basicblock.forward.out-self-bnn-out.2:start
        out = self.bn2(out)  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-bnn-out.2:end
        # @arch basicblock.forward.if-self-downsample-is-not-none:start
        if self.downsample is not None:
        # @arch basicblock.forward.if-self-downsample-is-not-none:end
            # @arch basicblock.forward.identity-self-downsample-x:start
            identity = self.downsample(x)  # (batch, in_channels, height, width) -> (batch, out_channels, out_height, out_width)
            # @arch basicblock.forward.identity-self-downsample-x:end

        # Add residual and apply final activation.
        # @arch basicblock.forward.out-out-identity:start
        out = out + identity  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-out-identity:end
        # @arch basicblock.forward.out-self-relu-out.2:start
        out = self.relu(out)  # (batch, out_channels, out_height, out_width)
        # @arch basicblock.forward.out-self-relu-out.2:end
        return out


# %% [notebook-only]
# Create and run residual basic blocks with and without projection.
example_plain_block = BasicBlock(in_channels=16, out_channels=16)
example_plain_input = torch.randn(2, 16, 32, 32)  # -> (2, 16, 32, 32)
example_plain_output = example_plain_block(example_plain_input)  # (2, 16, 32, 32) -> (2, 16, 32, 32)
example_projection = nn.Sequential(
    nn.Conv2d(16, 32, kernel_size=1, stride=2, bias=False),
    nn.BatchNorm2d(32),
)
example_projected_block = BasicBlock(16, 32, stride=2, downsample=example_projection)
example_projected_output = example_projected_block(example_plain_input)  # (2, 16, 32, 32) -> (2, 32, 16, 16)
print("plain block shape:", example_plain_output.shape, "projected block shape:", example_projected_output.shape)

