example_plain_block = Bottleneck(in_channels=64, out_channels=16)
example_plain_input = torch.randn(2, 64, 32, 32)  # -> (2, 64, 32, 32)
example_plain_output = example_plain_block(example_plain_input)  # (2, 64, 32, 32) -> (2, 64, 32, 32)
example_projection = nn.Sequential(
    nn.Conv2d(64, 128, kernel_size=1, stride=2, bias=False),
    nn.BatchNorm2d(128),
)
example_projected_block = Bottleneck(64, 32, stride=2, downsample=example_projection)
example_projected_output = example_projected_block(example_plain_input)  # (2, 64, 32, 32) -> (2, 128, 16, 16)
print("plain bottleneck shape:", example_plain_output.shape, "projected bottleneck shape:", example_projected_output.shape)

