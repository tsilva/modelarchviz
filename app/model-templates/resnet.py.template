class {{ className }}(nn.Module):
    def __init__(
        self,
        num_classes=1000  # Number of output classes.
    ):
        super().__init__()

        # Register stem, residual stages, global pool, and classifier.
        block = {{ blockClass }}
        self.in_channels = 64
        # @arch resnetn.self-stem-nn-sequential:start
        self.stem = nn.Sequential(
        # @arch resnetn.self-stem-nn-sequential:end
            # @arch resnetn.nn-convnd-n-n-kernel_size-n-stride-n-padding-n-bias-false:start
            nn.Conv2d(3, 64, kernel_size=7, stride=2, padding=3, bias=False),
            # @arch resnetn.nn-convnd-n-n-kernel_size-n-stride-n-padding-n-bias-false:end
            # @arch resnetn.nn-batchnormnd-n:start
            nn.BatchNorm2d(64),
            # @arch resnetn.nn-batchnormnd-n:end
            # @arch resnetn.nn-relu-inplace-true:start
            nn.ReLU(inplace=True),
            # @arch resnetn.nn-relu-inplace-true:end
        # @arch resnetn.code.4:start
        )
        # @arch resnetn.code.4:end
        # @arch resnetn.self-maxpool-nn-maxpoolnd-kernel_size-n-stride-n-padding-n:start
        self.maxpool = nn.MaxPool2d(kernel_size=3, stride=2, padding=1)
        # @arch resnetn.self-maxpool-nn-maxpoolnd-kernel_size-n-stride-n-padding-n:end
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n:start
        self.layer1 = self._make_layer(block, 64, blocks={{ stage1Blocks }}, stride=1)
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n:end
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.2:start
        self.layer2 = self._make_layer(block, 128, blocks={{ stage2Blocks }}, stride=2)
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.2:end
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.3:start
        self.layer3 = self._make_layer(block, 256, blocks={{ stage3Blocks }}, stride=2)
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.3:end
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.4:start
        self.layer4 = self._make_layer(block, 512, blocks={{ stage4Blocks }}, stride=2)
        # @arch resnetn.self-layern-self-_make_layer-block-n-blocks-n-stride-n.4:end
        # @arch resnetn.self-avgpool-nn-adaptiveavgpoolnd-n-n:start
        self.avgpool = nn.AdaptiveAvgPool2d((1, 1))
        # @arch resnetn.self-avgpool-nn-adaptiveavgpoolnd-n-n:end
        # @arch resnetn.self-fc-nn-linear-n-block-expansion-num_classes:start
        self.fc = nn.Linear(512 * block.expansion, num_classes)
        # @arch resnetn.self-fc-nn-linear-n-block-expansion-num_classes:end

    # @arch resnetn.def-_make_layer-self-block-out_channels-blocks-stride:start
    def _make_layer(self, block, out_channels, blocks, stride):
    # @arch resnetn.def-_make_layer-self-block-out_channels-blocks-stride:end
        # Build the optional projection when a stage changes shape.
        expanded_channels = out_channels * block.expansion
        downsample = None
        # @arch resnetn._make_layer.if-stride-n-or-self-in_channels-expanded_channels:start
        if stride != 1 or self.in_channels != expanded_channels:
        # @arch resnetn._make_layer.if-stride-n-or-self-in_channels-expanded_channels:end
            # @arch resnetn._make_layer.downsample-nn-sequential:start
            downsample = nn.Sequential(
            # @arch resnetn._make_layer.downsample-nn-sequential:end
                # @arch resnetn._make_layer.nn-convnd-self-in_channels-expanded_channels-kernel_size-n-stride-stride:start
                nn.Conv2d(self.in_channels, expanded_channels, kernel_size=1, stride=stride, bias=False),
                # @arch resnetn._make_layer.nn-convnd-self-in_channels-expanded_channels-kernel_size-n-stride-stride:end
                # @arch resnetn._make_layer.nn-batchnormnd-expanded_channels:start
                nn.BatchNorm2d(expanded_channels),
                # @arch resnetn._make_layer.nn-batchnormnd-expanded_channels:end
            )

        # Stack residual blocks for one ResNet stage.
        # @arch resnetn._make_layer.layers-block-self-in_channels-out_channels-stride-downsample:start
        layers = [block(self.in_channels, out_channels, stride, downsample)]
        # @arch resnetn._make_layer.layers-block-self-in_channels-out_channels-stride-downsample:end
        self.in_channels = expanded_channels
        # @arch resnetn._make_layer.for-_-in-range-n-blocks:start
        for _ in range(1, blocks):
        # @arch resnetn._make_layer.for-_-in-range-n-blocks:end
            # @arch resnetn._make_layer.current_block-block-self-in_channels-out_channels:start
            current_block = block(self.in_channels, out_channels)
            # @arch resnetn._make_layer.current_block-block-self-in_channels-out_channels:end
            layers.append(current_block)
        stage = nn.Sequential(*layers)
        return stage

    def forward(self, x):
        # Convert image input into stem features.
        # @arch resnetn.forward.x-self-stem-x:start
        x = self.stem(x)  # (batch, 3, 224, 224) -> (batch, 64, 112, 112)
        # @arch resnetn.forward.x-self-stem-x:end
        # @arch resnetn.forward.x-self-maxpool-x:start
        x = self.maxpool(x)  # (batch, 64, 112, 112) -> (batch, 64, 56, 56)
        # @arch resnetn.forward.x-self-maxpool-x:end

        # Run residual stages while reducing spatial size.
        # @arch resnetn.forward.x-self-layern-x:start
        x = self.layer1(x)  # (batch, 64, 56, 56)
        # @arch resnetn.forward.x-self-layern-x:end
        # @arch resnetn.forward.x-self-layern-x.2:start
        x = self.layer2(x)  # (batch, channels, 56, 56) -> (batch, channels, 28, 28)
        # @arch resnetn.forward.x-self-layern-x.2:end
        # @arch resnetn.forward.x-self-layern-x.3:start
        x = self.layer3(x)  # (batch, channels, 28, 28) -> (batch, channels, 14, 14)
        # @arch resnetn.forward.x-self-layern-x.3:end
        # @arch resnetn.forward.x-self-layern-x.4:start
        x = self.layer4(x)  # (batch, channels, 14, 14) -> (batch, channels, 7, 7)
        # @arch resnetn.forward.x-self-layern-x.4:end

        # Pool final features and classify.
        # @arch resnetn.forward.x-self-avgpool-x:start
        x = self.avgpool(x)  # (batch, channels, 7, 7) -> (batch, channels, 1, 1)
        # @arch resnetn.forward.x-self-avgpool-x:end
        # @arch resnetn.forward.x-torch-flatten-x-n:start
        x = torch.flatten(x, 1)  # (batch, channels, 1, 1) -> (batch, channels)
        # @arch resnetn.forward.x-torch-flatten-x-n:end
        # @arch resnetn.forward.logits-self-fc-x:start
        logits = self.fc(x)  # (batch, channels) -> (batch, num_classes)
        # @arch resnetn.forward.logits-self-fc-x:end
        return logits


