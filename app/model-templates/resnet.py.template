# @arch class-bottleneck-nn-module:start
class Bottleneck(nn.Module):
# @arch class-bottleneck-nn-module:end
    expansion = 4

    def __init__(
        self,
        in_channels,  # Number of input channels.
        out_channels,  # Bottleneck width before expansion.
        stride=1,  # Spatial stride for the 3x3 convolution.
        downsample=None  # Optional projection for the residual path.
    ):
        super().__init__()

        # Register the 1x1, 3x3, 1x1 bottleneck branch and optional projection shortcut.
        expanded_channels = out_channels * self.expansion
        # @arch bottleneck.self-convn-nn-convnd-in_channels-out_channels-kernel_size-n-bias-false:start
        self.conv1 = nn.Conv2d(in_channels, out_channels, kernel_size=1, bias=False)
        # @arch bottleneck.self-convn-nn-convnd-in_channels-out_channels-kernel_size-n-bias-false:end
        self.bn1 = nn.BatchNorm2d(out_channels)
        # @arch bottleneck.self-convn-nn-convnd:start
        self.conv2 = nn.Conv2d(
        # @arch bottleneck.self-convn-nn-convnd:end
            out_channels,
            out_channels,
            kernel_size=3,
            stride=stride,
            padding=1,
            bias=False,
        )
        self.bn2 = nn.BatchNorm2d(out_channels)
        # @arch bottleneck.self-convn-nn-convnd-out_channels-expanded_channels-kernel_size-n-bias-f:start
        self.conv3 = nn.Conv2d(out_channels, expanded_channels, kernel_size=1, bias=False)
        # @arch bottleneck.self-convn-nn-convnd-out_channels-expanded_channels-kernel_size-n-bias-f:end
        # @arch bottleneck.self-bnn-nn-batchnormnd-expanded_channels:start
        self.bn3 = nn.BatchNorm2d(expanded_channels)
        # @arch bottleneck.self-bnn-nn-batchnormnd-expanded_channels:end
        self.relu = nn.ReLU(inplace=True)
        self.downsample = downsample

    def forward(self, x):
        # Preserve the residual path, projecting it when shape changes.
        identity = x  # (batch, in_channels, height, width)

        # Reduce, process, and expand channels in the residual branch.
        # @arch bottleneck.forward.out-self-convn-x:start
        out = self.conv1(x)  # (batch, in_channels, height, width) -> (batch, out_channels, height, width)
        # @arch bottleneck.forward.out-self-convn-x:end
        # @arch bottleneck.forward.out-self-bnn-out:start
        out = self.bn1(out)  # (batch, out_channels, height, width)
        # @arch bottleneck.forward.out-self-bnn-out:end
        # @arch bottleneck.forward.out-self-relu-out:start
        out = self.relu(out)  # (batch, out_channels, height, width)
        # @arch bottleneck.forward.out-self-relu-out:end
        # @arch bottleneck.forward.out-self-convn-out:start
        out = self.conv2(out)  # (batch, out_channels, height, width) -> (batch, out_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-convn-out:end
        # @arch bottleneck.forward.out-self-bnn-out.2:start
        out = self.bn2(out)  # (batch, out_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-bnn-out.2:end
        # @arch bottleneck.forward.out-self-relu-out.2:start
        out = self.relu(out)  # (batch, out_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-relu-out.2:end
        # @arch bottleneck.forward.out-self-convn-out.2:start
        out = self.conv3(out)  # (batch, out_channels, out_height, out_width) -> (batch, expanded_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-convn-out.2:end
        # @arch bottleneck.forward.out-self-bnn-out.3:start
        out = self.bn3(out)  # (batch, expanded_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-bnn-out.3:end
        # @arch bottleneck.forward.if-self-downsample-is-not-none:start
        if self.downsample is not None:
        # @arch bottleneck.forward.if-self-downsample-is-not-none:end
            # @arch bottleneck.forward.identity-self-downsample-x:start
            identity = self.downsample(x)  # (batch, in_channels, height, width) -> (batch, expanded_channels, out_height, out_width)
            # @arch bottleneck.forward.identity-self-downsample-x:end

        # Add residual and apply final activation.
        # @arch bottleneck.forward.out-out-identity:start
        out = out + identity  # (batch, expanded_channels, out_height, out_width)
        # @arch bottleneck.forward.out-out-identity:end
        # @arch bottleneck.forward.out-self-relu-out.3:start
        out = self.relu(out)  # (batch, expanded_channels, out_height, out_width)
        # @arch bottleneck.forward.out-self-relu-out.3:end
        return out


